{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "ofwp32-fault-proxy-evidence",
        "namespace": "ofwp32"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "128Mi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "ofwp32-fault-proxy",
        "namespace": "ofwp32"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "ofwp32-fault-proxy"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ofwp32-fault-proxy"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "proxy",
                "image": "ofwp32/fault-proxy:runtime-sol-hold",
                "imagePullPolicy": "Never",
                "args": [
                  "--listen",
                  "0.0.0.0",
                  "--port",
                  "8080",
                  "--upstream",
                  "http://ofwp32-dvs:50078",
                  "--evidence-dir",
                  "/evidence",
                  "--timeout",
                  "30"
                ],
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "200m",
                    "memory": "128Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "evidence",
                    "mountPath": "/evidence"
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8080
                  },
                  "periodSeconds": 2
                }
              }
            ],
            "volumes": [
              {
                "name": "evidence",
                "persistentVolumeClaim": {
                  "claimName": "ofwp32-fault-proxy-evidence"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "ofwp32-fault-proxy",
        "namespace": "ofwp32"
      },
      "spec": {
        "selector": {
          "app": "ofwp32-fault-proxy"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    }
  ]
}
